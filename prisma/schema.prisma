// 生成 Prisma Client（默认 JS 实现）
generator client {
  provider = "prisma-client-js"
}

// 数据源：MySQL 8.0+，连接串从 .env 的 DATABASE_URL 读取
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * 用户表
 * 存储注册用户的基本信息，密码使用 bcrypt 哈希后保存
 */
model User {
  /// 主键，自增 ID
  id           Int       @id @default(autoincrement())
  /// 用户名（唯一，4-20 位字母数字下划线）
  username     String    @unique
  /// 邮箱（唯一）
  email        String    @unique
  /// bcrypt 加密后的密码哈希
  passwordHash String
  /// 昵称，可空
  nickname     String?
  /// 头像 URL，可空
  avatar       String?
  /// 用户主题（默认 light，可选：light/dark/system）
  theme        String   @default("light") @db.VarChar(10)
  /// 记录创建时间
  createdAt    DateTime  @default(now())
  /// 记录更新时间
  updatedAt    DateTime  @updatedAt

  /// 一个用户拥有多份简历，删除用户时级联删除所有简历
  resumes       Resume[]
  /// 一对多关联：用户配置的多个 AI 厂商
  aiProviders   AiProvider[]
  /// 一对一关联：用户的 AI 偏好（当前选中厂商 + 润色提示词）
  aiPreference  AiPreference?
}

/**
 * 简历表
 * 存储简历元信息 + 完整内容（内容为 JSON 字段，结构对应前端 Resume 类型）
 */
model Resume {
  /// 简历短 ID，5 位字符串（与前端保持一致的生成规则）
  id          String    @id @db.VarChar(10)
  /// 所属用户 ID（外键）
  userId      Int
  /// 使用的模板 ID
  templateId  String
  /// 简历标题
  title       String
  /// 完整简历内容（JSON 格式，对应前端 Resume 接口的完整对象）
  content     Json
  /// 创建时间
  createdAt   DateTime  @default(now())
  /// 更新时间
  updatedAt   DateTime?

  /// 与 User 表的关联关系：N : 1，级联删除
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 索引：按 userId 加速查询用户的全部简历
  @@index([userId])
  /// 索引：按更新时间倒序加速列表分页排序
  @@index([updatedAt])
}

/// AI 厂商配置表（每个用户可配置多个厂商，与 User 一对多）
model AiProvider {
  /// 主键，自增 ID
  id           Int      @id @default(autoincrement())
  /// 所属用户 ID（外键）
  userId       Int      @map("user_id")
  /// 厂商标识：deepseek / doubao / openai / custom-xxx
  providerId   String   @db.VarChar(64) @map("provider_id")
  /// 自定义供应商名称（内置厂商为空，用于路由 AI 请求）
  providerName String?  @db.VarChar(64) @map("provider_name")
  /// 加密后的 API Key（对称加密后的二进制，加密方案见设计文档第三节）
  apiKeyCipher Bytes?   @db.VarBinary(512) @map("api_key_cipher")
  /// API Key 尾号 4 位，用于脱敏展示
  apiKeyLast4  String?  @db.Char(4) @map("api_key_last4")
  /// 该厂商下默认使用的模型 ID
  modelId      String?  @db.VarChar(128) @map("model_id")
  /// API 接口地址（自定义厂商或代理地址）
  apiEndpoint  String?  @db.VarChar(255) @map("api_endpoint")
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// 与 User 表的关联关系：N : 1，级联删除
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 唯一约束：同一用户下厂商标识唯一（对应设计文档的 uk_user_provider）
  @@unique([userId, providerId], map: "uk_user_provider")
  /// 数据库表名映射为设计文档中的 snake_case 命名
  @@map("ai_provider")
}

/// 用户级偏好表（与 User 一对一：当前选中厂商 + 润色提示词）
model AiPreference {
  /// 用户 ID（主键即外键，一对一）
  userId             Int      @id @map("user_id")
  /// 当前选中的厂商 ID（对应 ai_provider.providerId）
  selectedProviderId String?  @db.VarChar(64) @map("selected_provider_id")
  /// 自定义润色提示词
  polishPrompt       String?  @db.Text @map("polish_prompt")
  /// 更新时间
  updatedAt          DateTime @updatedAt @map("updated_at")

  /// 与 User 表的关联关系：1 : 1，级联删除
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 数据库表名映射为设计文档中的 snake_case 命名
  @@map("ai_preference")
}